+		&& !TclIsVarUndefined(otherVarPtr)) {
+	    objResultPtr = TCONST(
+		    localVarPtr->value.objPtr != otherVarPtr->value.objPtr);
+	} else {
+	    objResultPtr = TCONST(1);
+	}
+	TRACE_APPEND_OBJ(objResultPtr);
+	NEXT_INST_F(5, 1, 1);
+    }
