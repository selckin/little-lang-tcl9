+# SC_PROG_BISON_FLEX --
+#
+#	Look for bison and flex, which are needed only to regenerate the L
+#	parser and scanner (pregenerated versions are used otherwise).
+#
+#------------------------------------------------------------------------
+
+AC_DEFUN([SC_PROG_BISON_FLEX], [
+    AC_CHECK_PROGS(BISON, [bison], [no])
+    AC_CHECK_PROGS(FLEX, [flex], [no])
+    AC_SUBST(BISON)
+    AC_SUBST(FLEX)
+])
+
