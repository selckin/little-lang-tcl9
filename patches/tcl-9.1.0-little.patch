+/*
+ *---------------------------------------------------------------------------
+ *
+ * Tcl_WriteObjN --
+ *
+ *	Same as Tcl_WriteObj but takes the maximum number of bytes to write
+ *	(used by L's write()). For a binary channel (no encoding, or
+ *	iso8859-1, which is what "-translation binary" selects in Tcl 9)
+ *	numBytes counts bytes of the binary value, i.e. characters; otherwise
+ *	it counts bytes of the (UTF-8) string rep and is rounded down to a
+ *	character boundary.
+ *
+ * Results:
+ *	The number of bytes written, or TCL_INDEX_NONE on error.
+ *
+ *---------------------------------------------------------------------------
+ */
+
+Tcl_Size
+Tcl_WriteObjN(
+    Tcl_Channel chan,		/* The channel to buffer output for. */
+    Tcl_Obj *objPtr,		/* The object to write. */
+    Tcl_Size numBytes)		/* The number of bytes to write. */
+{
+    Channel *chanPtr;
+    ChannelState *statePtr;	/* State info for channel */
+    const char *src;
+    Tcl_Size srcLen = 0;
+
+    statePtr = ((Channel *) chan)->state;
+    chanPtr = statePtr->topChanPtr;
+
+    if (CheckChannelErrors(statePtr, TCL_WRITABLE) != 0) {
+	return TCL_INDEX_NONE;
+    }
+    if (numBytes < 0) {
+	numBytes = 0;
+    }
+    if ((statePtr->encoding == NULL) || !strcmp("iso8859-1",
+	    Tcl_GetEncodingName(statePtr->encoding))) {
+	Tcl_Size numChars = Tcl_GetCharLength(objPtr), result;
+	Tcl_Obj *rangePtr;
+
+	if (numBytes >= numChars) {
+	    return Tcl_WriteObj(chan, objPtr);
+	} else if (numBytes == 0) {
+	    return 0;
+	}
+	rangePtr = Tcl_GetRange(objPtr, 0, numBytes - 1);
+	Tcl_IncrRefCount(rangePtr);
+	result = Tcl_WriteObj(chan, rangePtr);
+	Tcl_DecrRefCount(rangePtr);
+	return result;
+    }
+    src = TclGetStringFromObj(objPtr, &srcLen);
+    if (numBytes >= srcLen) {
+	numBytes = srcLen;
+    } else {
+	/* Don't split a character. */
+	numBytes = Tcl_UtfPrev(src + numBytes + 1, src) - src;
+    }
+    return WriteChars(chanPtr, src, numBytes);
+}
