+/*
+ *----------------------------------------------------------------------
+ *
+ * L_deepDiveString --
+ *
+ *	Index into a string for the L INST_L_INDEX bytecode.
+ *
+ * Results:
+ *	Creates a new Tcl_Obj that contains a substring of obj.  To be
+ *	compatible with the other L_deepDive* functions, this function returns
+ *	a Tcl_Obj** by storing the Tcl_Obj* into *strSlot and returning
+ *	strSlot.  (The caller moves it into the deep pointer if needed.)
+ *
+ *	If the given index is negative, a run-time error is generated.  If
+ *	the index is beyond the end of the string, a pointer the L undefined
+ *	object pointer is returned.  If the index is undef, throw a run-time
+ *	error.
+ *
+ * Side effects:
+ *	None.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static Tcl_Obj **
+L_deepDiveString(
+    Tcl_Interp *interp,
+    Tcl_Obj *obj,		/* object being indexed */
+    Tcl_Obj *idxObj,		/* index into obj */
+    Expr_f flags,
+    Tcl_Obj **strSlot)		/* where to store the new char object */
+{
+    int idx, ch;
+    Tcl_Obj *newObj;
+
+    if (L_isUndef(idxObj)) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj((flags & L_LVALUE)
+		? "cannot write to undefined string index"
+		: "cannot read from undefined string index", TCL_INDEX_NONE));
+	return NULL;
+    }
+    if (TclGetIntFromObj(NULL, idxObj, &idx) != TCL_OK) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		"cannot convert index to integer", TCL_INDEX_NONE));
+	return NULL;
+    }
+
+    if (idx < 0) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		"negative string index illegal", TCL_INDEX_NONE));
+	return NULL;
+    } else if (idx < Tcl_GetCharLength(obj)) {
+	ch = Tcl_GetUniChar(obj, idx);
+	if (TclIsPureByteArray(obj)) {
+	    unsigned char uch = (unsigned char) ch;
+
+	    newObj = Tcl_NewByteArrayObj(&uch, 1);
+	} else {
+	    char buf[TCL_UTF_MAX + 1];
+	    Tcl_Size len = Tcl_UniCharToUtf(ch, buf);
+
+	    newObj = Tcl_NewStringObj(buf, len);
+	}
+
+	*strSlot = newObj;
+	return strSlot;
+    } else {
+	return L_undefObjPtrPtr();
+    }
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
+ * L_deepDive --
+ *
+ *	Index one level into an L array, hash, struct, or string, using L
+ *	semantics.
+ *
+ * Results:
+ *	If flags & L_PUSH_VAL, the object is being indexed as an r-value.
+ *	Otherwise, it is assumed that the indexed value will be written
+ *	in-place later (i.e., used as an l-value), and this function does
+ *	the magic necessary to allow that.
+ *
+ *	This function returns a pointer to the indexed object pointer (i.e., a
+ *	Tcl_Obj **) that later can be used to modify the element in-place.  If
+ *	the indexed element does not exist, a pointer to the L undef object is
+ *	returned instead.
+ *
+ *	For an l-value, if the indexed element is shared, an un-shared copy is
+ *	made so that the indexed object later can be written in-place.
+ *
+ * Side effects:
+ *	See comments for L_deepDiveArray() and L_deepDiveHash().  The
+ *	object's string representation also is invalidated.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static Tcl_Obj **
+L_deepDive(
+    Tcl_Interp *interp,
+    Tcl_Obj *obj,
+    Tcl_Obj *idxObj,
+    Expr_f flags,
+    Tcl_Obj **strSlot)		/* storage for a string index result */
+{
+    Tcl_Obj **ret = NULL;
+
+    switch (flags & (L_IDX_ARRAY | L_IDX_HASH | L_IDX_STRING)) {
+    case L_IDX_ARRAY:
+	ret = L_deepDiveArray(interp, obj, idxObj, flags);
+	break;
+    case L_IDX_HASH:
+	ret = L_deepDiveHash(interp, obj, idxObj, flags);
+	break;
+    case L_IDX_STRING:
+	ret = L_deepDiveString(interp, obj, idxObj, flags, strSlot);
+	break;
+    default:
+	L_bomb("L_deepDive internal error");
+	break;
+    }
+    /* If we're going to write to obj, mark it as defined now. */
+    if (ret && (flags & L_LVALUE)) {
+	obj->undef = 0;
+    }
+    return ret;
+}
