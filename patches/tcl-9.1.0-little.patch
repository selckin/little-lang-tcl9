+	    deepPtrObj->typePtr = &L_deepPtr2Type;
+	    deepPtrObj->internalRep.twoPtrValue.ptr1 = newDeepPtr;
+	    deepPtrObj->internalRep.twoPtrValue.ptr2 = NULL;
