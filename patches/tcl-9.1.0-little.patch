+/*
+ *----------------------------------------------------------------------
+ *
+ * TclDuplicateListRep --
+ *
+ *	Make sure a list object has its own, unshared list internal
+ *	representation, so that its elements can be modified in place
+ *	through pointers into its element array (as the L deep-dive bytecodes
+ *	do). The object itself must be unshared.
+ *
+ * Results:
+ *	TCL_OK, or TCL_ERROR if the object cannot be converted to a list.
+ *
+ * Side effects:
+ *	Converts the object to a list if necessary. If the list's ListStore
+ *	is shared (or the list is a span of a larger store), the object's
+ *	internal representation is replaced by a newly allocated copy and its
+ *	string representation is invalidated.
+ *
+ *----------------------------------------------------------------------
+ */
+
+int
+TclDuplicateListRep(
+    Tcl_Obj *objPtr)
+{
+    ListRep listRep;
+
+    if (!TclHasInternalRep(objPtr, &tclListType)
+	    && (SetListFromAny(NULL, objPtr) != TCL_OK)) {
+	return TCL_ERROR;
+    }
+    ListObjGetRep(objPtr, &listRep);
+    if (ListRepIsShared(&listRep) || listRep.spanPtr) {
+	ListRep newRep;
+
+	ListRepClone(&listRep, &newRep, LISTREP_PANIC_ON_FAIL);
+	ListObjReplaceRepAndInvalidate(objPtr, &newRep);
+    }
+    return TCL_OK;
+}
