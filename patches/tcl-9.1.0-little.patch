+/*
+ *----------------------------------------------------------------------
+ *
+ * L_deepDiveArray --
+ *
+ *	Index one level into an L array or struct (represented as a Tcl list),
+ *	using L semantics.
+ *
+ * Results:
+ *	If flags & L_PUSH_VAL, the array is being indexed as an r-value.
+ *	Otherwise, it is assumed that the indexed value will be written
+ *	in-place later (i.e., used as an l-value), and this function does
+ *	the magic necessary to allow that.
+ *
+ *	For an r-value, this function returns a pointer to the indexed object
+ *	pointer (i.e., a Tcl_Obj ** pointer into the lists's internal element
+ *	array).  If the index is < 0 or beyond the last element, a pointer to
+ *	the L undef object is returned instead.
+ *
+ *	For an l-value, if the indexed element is shared, an un-shared copy is
+ *	made so that the indexed object later can be written in-place.  Also,
+ *	if the index is beyond the last element, the list is padded out with
+ *	copies of the L undef object.
+ *
+ * Side effects:
+ *	See above.  The lists's string representation also is invalidated.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static Tcl_Obj **
+L_deepDiveArray(
+    Tcl_Interp *interp,
+    Tcl_Obj *obj,		/* object being indexed */
+    Tcl_Obj *idxObj,		/* index (array subscript) into obj */
+    Expr_f flags)
+{
+    Tcl_Size i, len;
+    int idx;
+    Tcl_Obj **elemPtrs, **pad;
+    Tcl_Obj *subObj;
+    int lvalue = (flags & L_LVALUE);
+
+    if (L_isUndef(idxObj)) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(lvalue
+		? "cannot write to undefined array index"
+		: "cannot read from undefined array index", TCL_INDEX_NONE));
+	return NULL;
+    }
+    if (TclGetIntFromObj(NULL, idxObj, &idx) != TCL_OK) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		"cannot convert index to integer", TCL_INDEX_NONE));
+	return NULL;
+    }
+
+    if (!lvalue) {
+	if (TclListObjGetElements(NULL, obj, &len, &elemPtrs) != TCL_OK) {
+	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		    "cannot convert object to list", TCL_INDEX_NONE));
+	    return NULL;
+	}
+	if ((idx < 0) || (idx >= len)) {
+	    return L_undefObjPtrPtr();
+	}
+	return &elemPtrs[idx];
+    }
+
+    /*
+     * We are going to modify the list in place through a pointer into its
+     * element array, so it must have its own (unshared) element storage.
+     */
+
+    if (TclDuplicateListRep(obj) != TCL_OK) {
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		"cannot convert object to list", TCL_INDEX_NONE));
+	return NULL;
+    }
+    TclListObjLength(NULL, obj, &len);
+    if (idx < 0) {
+	if (flags & L_NEG_OK) {
+	    return L_undefObjPtrPtr();
+	}
+	Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		"cannot write to negative array index", TCL_INDEX_NONE));
+	return NULL;
+    } else if (idx >= len) {
+	/* Auto extend the array. */
+	Tcl_Size n = idx - len + 1;
+
+	pad = (Tcl_Obj **)Tcl_Alloc(n * sizeof(Tcl_Obj *));
+	for (i = 0; i < n; ++i) {
+	    pad[i] = *L_undefObjPtrPtr();
+	}
+	i = Tcl_ListObjReplace(interp, obj, len, 0, n, pad);
+	Tcl_Free(pad);
+	if ((i != TCL_OK) || (TclDuplicateListRep(obj) != TCL_OK)) {
+	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		    "cannot convert object to list", TCL_INDEX_NONE));
+	    return NULL;
+	}
+    }
+    TclListObjGetElements(NULL, obj, &len, &elemPtrs);
+    if (Tcl_IsShared(elemPtrs[idx])) {
+	/*
+	 * Make an un-shared copy of the element.  Because we're going to
+	 * later modify it in place, if the element is itself a list, we also
+	 * have to give it its own internal list representation because
+	 * Tcl_DuplicateObj() does not (it shares the internal list rep
+	 * between the old and new Tcl_Objs).
+	 */
+
+	subObj = Tcl_DuplicateObj(elemPtrs[idx]);
+	if (TclHasInternalRep(subObj, &tclListType)) {
+	    TclDuplicateListRep(subObj);
+	}
+	Tcl_IncrRefCount(subObj);
+	Tcl_DecrRefCount(elemPtrs[idx]);
+	elemPtrs[idx] = subObj;
+    }
+    TclInvalidateStringRep(obj);
+    return &elemPtrs[idx];
+}
