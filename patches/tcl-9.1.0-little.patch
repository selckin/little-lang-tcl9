+	    } else {
+		TclNewObj(newStr);
+	    }
+	    Tcl_IncrRefCount(newStr);
+	    if (Tcl_IsShared(newStr)) {
+		Tcl_DecrRefCount(newStr);
+		newStr = Tcl_DuplicateObj(newStr);
+		Tcl_IncrRefCount(newStr);
+	    }
+	    if (!(flags & L_DELETE)) {
