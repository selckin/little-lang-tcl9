+		(index == -1) ? TCL_SIZE_MAX : index,	/* -1 means append */
+		0, elc, elv) != TCL_OK) {
+	    TRACE_ERROR(interp);
+	    goto gotError;
+	}
+	TRACE_APPEND("OK\n");
+	NEXT_INST_F0(9, 2);
+    }
+
+    case INST_UNSET_LOCAL: {
+	unsigned int idx = TclGetUInt4AtPtr(pc+1);
+	Var *linkPtr;
+
+	/*
+	 * This is intended to delete L's local temp variables, which are
+	 * always scalars and never traced.
+	 */
+
+	varPtr = LOCAL(idx);
+	TRACE("%u => OK\n", idx);
+	if (TclIsVarLink(varPtr)) {
+	    linkPtr = varPtr->value.linkPtr;
+	    if (TclIsVarInHash(linkPtr)) {
+		VarHashRefCount(linkPtr)--;
+		if (TclIsVarUndefined(linkPtr)) {
+		    TclCleanupVar(linkPtr, NULL);
+		}
+	    }
+	    TclSetVarScalar(varPtr);
+	    varPtr->value.linkPtr = NULL;
+	} else if (!TclIsVarUndefined(varPtr)) {
+	    TclDecrRefCount(varPtr->value.objPtr);
+	    varPtr->value.objPtr = NULL;
+	    TclSetVarUndefined(varPtr);
+	}
+	NEXT_INST_F0(5, 0);
+    }
+
+    case INST_DIFFERENT_OBJ: {
+	unsigned int idx = TclGetUInt4AtPtr(pc+1);
+	Var *localVarPtr = LOCALVAR(idx);
+	Var *otherVarPtr;
+
+	TRACE("%u \"%.30s\" => ", idx, O2S(OBJ_AT_TOS));
+	DECACHE_STACK_INFO();
