+/*
+ *----------------------------------------------------------------------
+ *
+ * FsMaybeWrapInLLang --
+ *
+ *	Handle L and html/L code.  If the path ends in .l (or L forcing is
+ *	on), precede the file contents with "#lang L".  If the path ends in
+ *	.lhtml, with "#lang Lhtml".
+ *
+ * Results:
+ *	A Tcl_Obj (with a reference held for the caller) containing the
+ *	potentially wrapped script.  The reference on fileContents is
+ *	transferred to the result.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static Tcl_Obj *
+FsMaybeWrapInLLang(
+    Tcl_Obj *fileContents,
+    const char *path)
+{
+    Tcl_Size flen;
+    size_t plen = strlen(path);
+    const char *s = TclGetStringFromObj(fileContents, &flen);
+    const char *append = "";
+    const char *lang = NULL;
+    Tcl_Obj *newContents;
+
+    if (((plen >= 2) && !strcmp(path + plen - 2, ".l"))
+	    || (L && L->global->forceL)) {
+	lang = "L";
+	if (L) {
+	    L->global->forceL = 0;
+	}
+    } else if ((plen >= 6) && !strcmp(path + plen - 6, ".lhtml")) {
+	lang = "Lhtml";
+    }
+    if (lang == NULL) {
+	return fileContents;
+    }
+
+    /* Append a newline if not already there. */
+    if (flen && (s[flen-1] != '\n')) {
+	append = "\n";
+    }
+    newContents = Tcl_ObjPrintf("#lang %s --lineadj=-1\n%s%s#lang tcl",
+	    lang, s, append);
+    Tcl_IncrRefCount(newContents);
+    Tcl_DecrRefCount(fileContents);
+    return newContents;
+}
