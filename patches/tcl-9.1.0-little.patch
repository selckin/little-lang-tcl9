+	TRACE_APPEND("%" SIZEd " on L sizes stack\n", length);
+	NEXT_INST_F0(1, 0);
+
+    case INST_L_PUSH_STR_SIZE:
+	valuePtr = OBJ_AT_TOS;
+	if (L_isDeepPtr(valuePtr)) {
+	    valuePtr = *L_deepPtrGet(valuePtr)->elemPtrPtr;
+	}
+	TRACE("\"%.20s\" => ", O2S(valuePtr));
+	length = Tcl_GetCharLength(valuePtr);
+	L_sizes_push(length - 1);
+	TRACE_APPEND("%" SIZEd " on L sizes stack\n", length);
+	NEXT_INST_F0(1, 0);
+
+    case INST_L_READ_SIZE:
+	length = L_sizes_top();
+	TclNewIntObj(objResultPtr, length);
+	TRACE("=> %" SIZEd "\n", length);
+	NEXT_INST_F(1, 0, 1);
+
+    case INST_L_POP_SIZE:
+	L_sizes_pop();
+	TRACE("=> OK\n");
+	NEXT_INST_F0(1, 0);
+
+    case INST_L_PUSH_UNDEF:
+	objResultPtr = *L_undefObjPtrPtr();
+	TRACE("=> undef\n");
+	NEXT_INST_F(1, 0, 1);
+
+    case INST_L_LINDEX_STK: {
+	Tcl_Size listc;
+	Tcl_Obj **listv;
+	unsigned int i = TclGetUInt1AtPtr(pc+1);
+
+	TRACE("%u \"%.30s\" => ", i, O2S(OBJ_AT_TOS));
+	if (TclListObjGetElements(interp, OBJ_AT_TOS, &listc,
+		&listv) != TCL_OK) {
+	    TRACE_ERROR(interp);
+	    goto gotError;
+	}
+	if (i < (size_t) listc) {
+	    objResultPtr = listv[i];
+	} else {
+	    objResultPtr = *L_undefObjPtrPtr();
+	}
+	TRACE_APPEND_OBJ(objResultPtr);
+	NEXT_INST_F(2, 0, 1);
+    }
+
+    case INST_L_LIST_INSERT: {
+	int index;
+	Tcl_Size elc;
+	Tcl_Obj **elv, *listPtr, *indexPtr, *elemPtr;
+	unsigned int idx = TclGetUInt4AtPtr(pc+1);
+	unsigned int flags = TclGetUInt4AtPtr(pc+5);
+
+	indexPtr = OBJ_AT_TOS;
+	elemPtr = OBJ_UNDER_TOS;
+	TRACE("%u 0x%x \"%.30s\" \"%.30s\" => ", idx, flags, O2S(elemPtr),
+		O2S(indexPtr));
+	if (TclGetIntFromObj(NULL, indexPtr, &index) != TCL_OK) {
+	    Tcl_SetObjResult(interp, Tcl_NewStringObj(
+		    "cannot convert index to integer", TCL_INDEX_NONE));
+	    TRACE_ERROR(interp);
+	    goto gotError;
+	}
+	varPtr = LOCALVAR(idx);
+	listPtr = varPtr->value.objPtr;
+	if ((listPtr == NULL) || Tcl_IsShared(listPtr)) {
+	    listPtr = listPtr ? Tcl_DuplicateObj(listPtr) : Tcl_NewObj();
+	    DECACHE_STACK_INFO();
+	    if (!TclPtrSetVarIdx(interp, varPtr, NULL, NULL, NULL, listPtr,
+		    TCL_LEAVE_ERR_MSG, idx)) {
+		CACHE_STACK_INFO();
+		TRACE_ERROR(interp);
+		goto gotError;
+	    }
+	    CACHE_STACK_INFO();
+	}
+	if (flags & L_INSERT_ELT) {
+	    elc = 1;
+	    elv = &elemPtr;
+	} else {
+	    ASSERT(flags & L_INSERT_LIST);
+	    if (TclListObjGetElements(interp, elemPtr, &elc, &elv) != TCL_OK) {
+		TRACE_ERROR(interp);
+		goto gotError;
+	    }
+	}
