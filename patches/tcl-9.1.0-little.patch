+/*
+ *----------------------------------------------------------------------
+ *
+ * PcreError --
+ *
+ *	Leave a PCRE error message in the interpreter, if there is one.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static void
+PcreError(
+    Tcl_Interp *interp,
+    const char *prefix,
+    int errorCode)
+{
+    PCRE2_UCHAR buf[256];
+
+    if (interp == NULL) {
+	return;
+    }
+    if (pcre2_get_error_message(errorCode, buf, sizeof(buf)) < 0) {
+	snprintf((char *) buf, sizeof(buf), "error code %d", errorCode);
+    }
+    Tcl_SetObjResult(interp, Tcl_ObjPrintf("%s%s", prefix, (char *) buf));
