+/*
+ *----------------------------------------------------------------------
+ *
+ * PcreNulCopy --
+ *
+ *	Tcl encodes NUL as the (overlong) sequence C0 80, which PCRE2 does
+ *	not accept as UTF-8. If string contains any, return a Tcl_Alloc'd
+ *	copy with real NULs instead (and update *lengthPtr), else NULL.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static char *
+PcreNulCopy(
+    const char *string,
+    Tcl_Size *lengthPtr)
+{
+    Tcl_Size i, j, length = *lengthPtr;
+    char *copy;
+
+    if ((length == 0) || (memchr(string, 0xC0, length) == NULL)) {
+	return NULL;
+    }
+    copy = (char *)Tcl_Alloc(length + 1);
+    for (i = j = 0; i < length; i++, j++) {
+	if ((UCHAR(string[i]) == 0xC0) && (i + 1 < length)
+		&& (UCHAR(string[i+1]) == 0x80)) {
+	    copy[j] = 0;
+	    i++;
+	} else {
+	    copy[j] = string[i];
+	}
+    }
+    copy[j] = 0;
+    *lengthPtr = j;
+    return copy;
+}
+
+/*
+ *----------------------------------------------------------------------
+ *
+ * PcreSubject --
+ *
+ *	Get the subject string for a PCRE match.  Byte arrays are matched
+ *	byte-wise, everything else against its (UTF-8) string rep.
+ *
+ * Results:
+ *	A pointer to the bytes to match; the length is stored in *lengthPtr
+ *	and *isBytesPtr is set to 1 if offsets are byte offsets. If the
+ *	string rep had to be converted (see PcreNulCopy), *copyPtr is set
+ *	to the copy (which the caller must Tcl_Free), else to NULL.
+ *
+ *----------------------------------------------------------------------
+ */
+
+static const char *
+PcreSubject(
+    Tcl_Obj *textObj,
+    Tcl_Size *lengthPtr,
+    int *isBytesPtr,
+    char **copyPtr)
+{
+    const char *string;
+
+    *copyPtr = NULL;
+    if (TclIsPureByteArray(textObj)) {
+	const char *bytes = (const char *)
+		Tcl_GetBytesFromObj(NULL, textObj, lengthPtr);
+
+	if (bytes != NULL) {
+	    *isBytesPtr = 1;
+	    return bytes;
+	}
+    }
+    *isBytesPtr = 0;
+    string = TclGetStringFromObj(textObj, lengthPtr);
+    *copyPtr = PcreNulCopy(string, lengthPtr);
+    return *copyPtr ? *copyPtr : string;
