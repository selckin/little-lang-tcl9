+
+    case INST_L_PUSH_LIST_SIZE:
+	valuePtr = OBJ_AT_TOS;
+	if (L_isDeepPtr(valuePtr)) {
+	    valuePtr = *L_deepPtrGet(valuePtr)->elemPtrPtr;
+	}
+	TRACE("\"%.20s\" => ", O2S(valuePtr));
+	if (TclListObjLength(interp, valuePtr, &length) != TCL_OK) {
+	    TRACE_ERROR(interp);
+	    goto gotError;
+	}
