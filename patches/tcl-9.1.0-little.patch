+static int
+PcreCompile(
+    Tcl_Interp *interp,
+    TclRegexp *regexpPtr,
+    const char *string,
+    size_t length)
+{
+    uint32_t options = PCRE2_DOLLAR_ENDONLY | PCRE2_DOTALL;
+    uint32_t captureCount = 0;
+    int flags = regexpPtr->flags, errorCode;
+    PCRE2_SIZE errorOffset;
