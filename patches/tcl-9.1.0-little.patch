+#------------------------------------------------------------------------
+# SC_ENABLE_PCRE --
+#
+#	Allows building with the PCRE2 regular expression library, which is
+#	used by the L language and by "regexp -type pcre".
+#
+# Arguments:
+#	none
+#
+# Results:
+#	Adds the following arguments to configure:
+#		--enable-pcre=yes|no|default
+#		--with-pcre=DIR
+#
+#	"default" (the default) also makes PCRE the default RE engine of new
+#	interps (overridable with TCL_REGEXP_CLASSIC in the environment).
+#
+#	Defines the following vars:
+#		PCRE_INCLUDE	Compiler flags for PCRE2
+#		PCRE_LIBS	Linker flags for PCRE2 (also added to LIBS)
+#		HAVE_PCRE	If PCRE2 support is enabled
+#		USE_DEFAULT_PCRE If PCRE is the default RE engine
+#------------------------------------------------------------------------
+
+AC_DEFUN([SC_ENABLE_PCRE], [
+    AC_ARG_ENABLE(pcre,
+	AS_HELP_STRING([--enable-pcre=yes|no|default],
+	    [build with PCRE2 support; "default" also makes PCRE the default RE engine (default: default)]),
+	[tcl_pcre=$enableval], [tcl_pcre=default])
+    AC_ARG_WITH(pcre,
+	AS_HELP_STRING([--with-pcre=DIR],
+	    [directory containing the PCRE2 include/ and lib/ directories]),
+	[with_pcre=${withval}])
+    PCRE_INCLUDE=""
+    PCRE_LIBS=""
+    AS_IF([test "$tcl_pcre" != "no"], [
+	AC_MSG_CHECKING([for PCRE2])
+	AS_IF([test x"${with_pcre}" != x], [
+	    PCRE_INCLUDE="-I${with_pcre}/include"
+	    PCRE_LIBS="-L${with_pcre}/lib -lpcre2-8"
+	], [${PKG_CONFIG:-pkg-config} --exists libpcre2-8 2>/dev/null], [
+	    PCRE_INCLUDE=`${PKG_CONFIG:-pkg-config} --cflags libpcre2-8`
+	    PCRE_LIBS=`${PKG_CONFIG:-pkg-config} --libs libpcre2-8`
+	], [pcre2-config --version >/dev/null 2>&1], [
+	    PCRE_INCLUDE=`pcre2-config --cflags`
+	    PCRE_LIBS=`pcre2-config --libs8`
+	], [
+	    PCRE_LIBS="-lpcre2-8"
+	])
+	tcl_save_CFLAGS="$CFLAGS"
+	tcl_save_LIBS="$LIBS"
+	CFLAGS="$CFLAGS $PCRE_INCLUDE"
+	LIBS="$LIBS $PCRE_LIBS"
+	AC_LINK_IFELSE([AC_LANG_PROGRAM([[
+#define PCRE2_CODE_UNIT_WIDTH 8
+#include <pcre2.h>
+	    ]], [[
+int err; PCRE2_SIZE off;
+pcre2_code *re = pcre2_compile((PCRE2_SPTR) "a", 1, 0, &err, &off, NULL);
+pcre2_code_free(re);
+	    ]])], [tcl_pcre_found=yes], [tcl_pcre_found=no])
+	CFLAGS="$tcl_save_CFLAGS"
+	LIBS="$tcl_save_LIBS"
+	AC_MSG_RESULT([$tcl_pcre_found])
+	AS_IF([test "$tcl_pcre_found" = yes], [
+	    LIBS="$LIBS $PCRE_LIBS"
+	    AC_DEFINE(HAVE_PCRE, 1, [Do we enable PCRE interfaces?])
+	    AS_IF([test "$tcl_pcre" = default], [
+		AC_DEFINE(USE_DEFAULT_PCRE, 1, [Use PCRE as default RE engine?])
+	    ])
+	], [
+	    AC_MSG_ERROR([PCRE2 (libpcre2-8) not found; it is required by L. Use --with-pcre=DIR or --disable-pcre])
